# Obrigatória para moderação, embeddings OpenAI e síntese
OPENAI_API_KEY=

# Devem corresponder ao provedor, modelo e colecao usados na indexacao.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_COLLECTION=fact_checks_pt_v2_openai
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant_db

# Recuperação (relevância, não probabilidade de veracidade)
SIMILARITY_THRESHOLD=0.60
RETRIEVAL_TOP_K=5
RETRIEVAL_OVERFETCH=3
MAX_DOCUMENTS=3
MAX_CONTEXT_CHARS=4000

# Geração: mantenha openai por padrão. Para Ollama, use por exemplo:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://host.docker.internal:11434/v1/
# LLM_API_KEY=ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
TAVILY_API_KEY=

# ─── LLM ──────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Qdrant HTTP recomendado. Vazio usa o índice local em QDRANT_PATH.
# Nunca aponte --recreate/ingest para o índice de referência.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant_db
QDRANT_COLLECTION=fact_checks_pt_v2_openai

# Recuperação (relevância, não probabilidade de veracidade)
# Produção só usa artefato reliable=true promovido para production.
# Para reproduzir o piloto com o limiar 0.65, defina RETRIEVAL_CALIBRATION_TIER=pilot.
RETRIEVAL_CALIBRATION_TIER=production
# Vazio = aplica a política acima ao artefato em evals/calibrated_thresholds.json.
# Definir aqui SOBRESCREVE o valor calibrado.
# SIMILARITY_THRESHOLD=0.65
RETRIEVAL_TOP_K=5
RETRIEVAL_OVERFETCH=3
MAX_DOCUMENTS=3
MAX_CONTEXT_CHARS=4000

# LLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Observabilidade opcional
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
PROMPT_LABEL=production

# Smoke E2E real. RUN_E2E pode ser definido no shell ou aqui.
RUN_E2E=
# Só use 1 ao consultar diretamente o índice embarcado de referência.
E2E_ALLOW_REFERENCE_LOCAL_INDEX=0

# Avaliação offline de classificadores (não usada por /api/debunk)
# Aponte para arquivos externos; não copie pesos ou dados curados para o Git.
CLASSIFIER_TFIDF_MODEL_PATH=
CLASSIFIER_TFIDF_METRICS_PATH=
CLASSIFIER_TFIDF_PREDICTIONS_PATH=
CLASSIFIER_BERTIMBAU_MODEL_PATH=
CLASSIFIER_BERTIMBAU_METRICS_PATH=
CLASSIFIER_BERTIMBAU_PREDICTIONS_PATH=
CLASSIFIER_EXTERNAL_DATASET_PATH=
CLASSIFIER_EVALUATION_OUTPUT_DIR=reports/classifier-evaluation
CLASSIFIER_BERTIMBAU_DEVICE=cpu
CLASSIFIER_BERTIMBAU_BATCH_SIZE=16
CLASSIFIER_DECISION_THRESHOLD=0.5
CLASSIFIER_ENABLED=false
CLASSIFIER_BACKEND=bertimbau

# --- Retrieval avancado / NER / NLI (todos opcionais) ---
HYBRID_ENABLED=false
HYBRID_LEXICAL_WEIGHT=1.2
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=15
NER_BACKEND=auto
NER_SPACY_MODEL=pt_core_news_lg
NLI_ENABLED=false
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_MODEL_REVISION=b5113eb
# auto escolhe CUDA, MPS ou CPU; valores explícitos: cuda, mps, cpu
NLI_DEVICE=auto
NLI_ABSTAIN_ON_DISAGREEMENT=false

# ─── Contrato backend↔ML ─────────────────────────────────────────
# Se definido, POST /api/v1/verify exige o header X-Internal-Token (mesmo valor do backend).
# INTERNAL_API_TOKEN=
